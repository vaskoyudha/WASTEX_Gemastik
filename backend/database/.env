# WASTEX Supabase Configuration
# Replace placeholder values below with your actual Supabase project credentials

# Main Supabase Project URL (format: https://xxxxx.supabase.co)
SUPABASE_URL=https://xxxxxx.supabase.co

# Service Role Key (found in Project Settings > API > Service Role Keys)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Anon/Public Key (for client-side usage from mobile app)
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Database password for psql connection
DATABASE_PASSWORD=your-postgres-password

# OpenAI API Key (optional, for embedding generation during skill seeding)
OPENAI_API_KEY=sk-your-openai-key-here

=== HOW TO GET THESE VALUES ===

1. SUPABASE_URL: Go to https://supabase.com/dashboard → Your Project → Settings → API
2. SUPABASE_SERVICE_ROLE_KEY & SUPABASE_ANON_KEY: Same page under "Project API keys"
3. DATABASE_PASSWORD: Go to Settings → Database → Passwords
4. OPENAI_API_KEY: Get from https://platform.openai.com/api-keys

Then run: python scripts/deploy_migrations.py
